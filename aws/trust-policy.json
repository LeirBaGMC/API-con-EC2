{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::520369550160:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": [
        "sts:AssumeRoleWithWebIdentity",
        "sts:TagSession"
      ],
      "Condition": {
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "*API-con-EC2*",
            "*api-con-ec2*"
          ]
        }
      }
    }
  ]
}
